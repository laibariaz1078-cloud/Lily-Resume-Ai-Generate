NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb://127.0.0.1:27017/lily_resume_api
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

SESSION_COOKIE_NAME=lily_session
SESSION_TTL_HOURS=24
REMEMBER_ME_TTL_DAYS=30
SESSION_COOKIE_SAME_SITE=lax

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Lily Studio <no-reply@example.com>
PASSWORD_RESET_URL=http://localhost:3000/forgot-password

AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
FREE_AI_MONTHLY_LIMIT=50
PREMIUM_AI_MONTHLY_LIMIT=1000
