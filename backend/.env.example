NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/Lily_resume_api
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
CLIENT_URL=http://localhost:3000

# SMTP is required to deliver password-reset links. The API never returns reset tokens.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Lily Studio <no-reply@example.com>
PASSWORD_RESET_URL=http://localhost:3000/reset-password
